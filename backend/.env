# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=15728640

# --- Postgres ---
DATABASE_URL=postgres://ttg:ttg@localhost:5432/ttg_docs

# --- Rendered file storage (mount a PVC here in k8s) ---
OUTPUT_DIR=/data/outputs

# --- Structuring engine ---
# "groq"         = LLM (Groq API, OpenAI-compatible) — best quality, understands
#                  a custom prompt. Needs GROQ_API_KEY. Falls back to transformers/
#                  heuristic automatically on any failure.
# "transformers" = local pre-trained zero-shot model (Transformers.js / ONNX), no API key
# "heuristic"    = pure-JS keyword routing (no model, no download, no API key)
STRUCTURER=groq
# Only read when STRUCTURER=groq. Get a key at https://console.groq.com/keys —
# never commit a real value here.
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=45000
# Local zero-shot model (Hugging Face id, Transformers.js/ONNX compatible)
ZEROSHOT_MODEL=Xenova/nli-deberta-v3-xsmall
# Where model weights are cached (pre-downloaded at Docker build)
TRANSFORMERS_CACHE_DIR=/models
# Run fully offline at runtime (weights must be pre-downloaded); set false to allow download
TRANSFORMERS_OFFLINE=true
